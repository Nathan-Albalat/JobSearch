ANTHROPIC_API_KEY=your_key_here

# --- Notifications email (optionnel) ---
# Laisser NOTIFY_EMAIL vide pour désactiver les notifications
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
# Pour Gmail : créer un "App Password" sur myaccount.google.com/apppasswords
# (pas le mot de passe habituel — nécessite la validation en 2 étapes activée)
SMTP_PASSWORD=
